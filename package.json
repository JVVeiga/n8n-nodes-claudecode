{
  "name": "@joaoveiga/n8n-nodes-claudecode",
  "version": "1.1.0",
  "description": "Five n8n nodes for Claude Code v2 via the Claude Agent SDK: the agent (attachments, effort, thinking, Ultracode, tool restriction, spend cap, graceful timeouts, diagnostics), a Chat Model and two Agent tools for n8n AI Agents, plus a free usage read for plan limits and reset windows",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "claude",
    "claude-code",
    "ai",
    "anthropic",
    "mcp",
    "model-context-protocol",
    "attachments",
    "vision",
    "binary-data",
    "rate-limits",
    "usage"
  ],
  "license": "MIT",
  "homepage": "https://github.com/JVVeiga/n8n-nodes-claudecode#readme",
  "bugs": {
    "url": "https://github.com/JVVeiga/n8n-nodes-claudecode/issues"
  },
  "author": {
    "name": "Jo\u00e3o Veiga",
    "email": "joaovveiga@gaudium.com.br"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JVVeiga/n8n-nodes-claudecode.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "index.js",
  "scripts": {
    "build": "npm run format:check && npx rimraf dist && tsc && gulp build:icons",
    "format:check": "prettier nodes credentials tests --check",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials tests --write",
    "test": "tsc -p tsconfig.test.json && node --test \".tmp/tests/tests/**/*.test.js\"",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build && npm run lint -c .eslintrc.prepublish.js nodes credentials package.json",
    "e2e:guard": "test -f scripts/e2e/n8n-up.sh || { echo 'scripts/e2e/n8n-up.sh is missing. It is versioned \u2014 restore it with: git checkout scripts/e2e' >&2; exit 1; }",
    "e2e:up": "npm run e2e:guard && bash scripts/e2e/n8n-up.sh",
    "e2e:run": "npm run e2e:guard && node scripts/e2e/run-cases.mjs",
    "e2e:verdict": "npm run e2e:guard && node scripts/e2e/verdict.mjs",
    "commit": "cz"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/ClaudeCodeApi.credentials.js",
      "dist/credentials/ClaudeCodeOAuthTokenApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/ClaudeCode/ClaudeCode.node.js",
      "dist/nodes/ClaudeCodeUsage/ClaudeCodeUsage.node.js",
      "dist/nodes/ClaudeCodeChatModel/ClaudeCodeChatModel.node.js",
      "dist/nodes/ClaudeCodeTool/ClaudeCodeTool.node.js",
      "dist/nodes/ClaudeCodeUsageTool/ClaudeCodeUsageTool.node.js"
    ]
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.202",
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@langchain/core": "^1.2.9",
    "@types/node": "^22.13.10",
    "@typescript-eslint/parser": "~8.32.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "@langchain/core": "^1.0.0",
    "n8n-workflow": "*",
    "zod": ">=3.25.0 <5"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "contributors": [
    {
      "name": "Adam Holt",
      "url": "https://github.com/holt-web-ai"
    },
    {
      "name": "John Lindquist",
      "url": "https://github.com/johnlindquist"
    }
  ]
}
