{
  "name": "@joaoveiga/n8n-nodes-claudecode",
  "version": "0.8.0",
  "description": "Fork of @johnlindquist/n8n-nodes-claudecode: n8n node for Claude Code v2 via the Claude Agent SDK, with effort, thinking, Ultracode, tool restriction, a spend cap and run diagnostics",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "claude",
    "claude-code",
    "ai",
    "anthropic",
    "mcp",
    "model-context-protocol"
  ],
  "license": "MIT",
  "homepage": "https://github.com/JVVeiga/n8n-nodes-claudecode#readme",
  "bugs": {
    "url": "https://github.com/JVVeiga/n8n-nodes-claudecode/issues"
  },
  "author": {
    "name": "João Veiga",
    "email": "joaovveiga@gaudium.com.br"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JVVeiga/n8n-nodes-claudecode.git"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "index.js",
  "scripts": {
    "build": "npm run format:check && npx rimraf dist && tsc && gulp build:icons",
    "format:check": "prettier nodes tests --check",
    "dev": "tsc --watch",
    "format": "prettier nodes tests --write",
    "test": "tsc -p tsconfig.test.json && node --test \".tmp/tests/tests/**/*.test.js\"",
    "lint": "eslint nodes package.json",
    "lintfix": "eslint nodes package.json --fix",
    "prepublishOnly": "npm run build && npm run lint -c .eslintrc.prepublish.js nodes package.json",
    "commit": "cz"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "nodes": [
      "dist/nodes/ClaudeCode/ClaudeCode.node.js"
    ]
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.202"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.1",
    "@semantic-release/npm": "^12.0.1",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "@types/node": "^22.13.10",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "@typescript-eslint/parser": "~8.32.0",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "prettier": "^3.5.3",
    "semantic-release": "^24.2.0",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "contributors": [
    {
      "name": "Adam Holt",
      "url": "https://github.com/holt-web-ai"
    },
    {
      "name": "John Lindquist",
      "url": "https://github.com/johnlindquist"
    }
  ]
}
